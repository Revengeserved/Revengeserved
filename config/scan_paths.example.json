{
  "version": "0.1.0",
  "default_scan_mode": "metadata_only",
  "require_scan_root_approval": true,
  "follow_symlinks": false,
  "allow_live_cloud_roots": false,
  "allow_file_modification": false,
  "roots": [
    {
      "source_type": "local_export",
      "source_account": "example",
      "path": "/path/to/exported/user/files",
      "enabled": false,
      "approved": false,
      "notes": "Example only. Use local exported user files for first scans. Do not point this at system folders or live cloud sync roots."
    }
  ]
}
